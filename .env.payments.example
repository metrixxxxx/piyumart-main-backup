# Copy these names into .env.local. Never put secrets in NEXT_PUBLIC_* variables.
# This implementation intentionally rejects sk_live_* keys.
PAYMONGO_SECRET_KEY=sk_test_replace_with_your_own_key
PAYMONGO_WEBHOOK_SECRET=replace_with_the_test_webhook_signing_secret
PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya,qrph
APP_URL=http://localhost:3000
# Generate 32 random bytes as 64 hex characters; retain this key for existing destinations.
WALLET_ENCRYPTION_KEY=replace_with_64_hex_characters
# Keep false for the demo until PayMongo activates your TEST Wallet/Transfers access.
PAYMONGO_PAYOUTS_ENABLED=false
# Reuse the existing CRON_SECRET or configure a random secret.
CRON_SECRET=replace_with_a_random_secret
